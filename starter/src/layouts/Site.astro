---
import Layout from '@effortlessmetrics/still/layout';
import Header from '@effortlessmetrics/still/header';
import Footer from '@effortlessmetrics/still/footer';
import '@effortlessmetrics/still/styles.css';
import '../styles/starter.css';
interface Props {title:string;description:string;canonicalPath?:string;}
const {title,description,canonicalPath='/'}=Astro.props;
const origin=Astro.site?.origin ?? 'https://clear-current.example';
---
<Layout title={title+' | Clear Current'} description={description} origin={origin} canonicalPath={canonicalPath} production={import.meta.env.PUBLIC_SITE_ENV==='production'} themeStorageKey="clear-current-theme" themeButtonId="site-theme-toggle">
<Header slot="header" brand="Clear Current" themeButtonId="site-theme-toggle" links={[{label:'Workshops',href:'/workshops/'},{label:'Project support',href:'/project-support/'},{label:'Contact',href:'/contact/'}]}>
<svg slot="theme" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"/></svg>
</Header>
<slot/>
<Footer slot="footer"><span>Clear Current / <a href="/contact/">Start a conversation</a></span></Footer>
</Layout>
