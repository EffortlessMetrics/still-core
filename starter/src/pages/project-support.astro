---
import Site from '../layouts/Site.astro';
import ServicePage from '@effortlessmetrics/still/service-page';
import ServiceColumns from '@effortlessmetrics/still/service-columns';
import ServiceOffer from '@effortlessmetrics/still/service-offer';
import Action from '@effortlessmetrics/still/action';
---
<Site title="Project support" description="Independent review and practical working sessions for a project that needs a clear next step." canonicalPath="/project-support/">
<ServicePage><p class="eyebrow">Project support</p><h1>Move from a plan<br/>to <em>something useful.</em></h1><p class="package-details">Bring the material you have. We will identify one tractable piece of work and a way to judge whether it helps.</p>
<ServiceColumns columns={2}>
<ServiceOffer class="offer" headingId="review"><span slot="heading">A second look</span>Review a draft, prototype, or handoff. Receive a short set of observations and the questions worth resolving next.<span slot="price">By arrangement</span></ServiceOffer>
<ServiceOffer class="offer" headingId="working-session"><span slot="heading">A working session</span>Work through a bounded problem together. Finish with a concrete draft or experiment that your team can continue.<span slot="price">By arrangement</span></ServiceOffer>
</ServiceColumns><p class="package-details">Scope and responsibilities stay explicit. This example makes no delivery or pricing promise.</p><Action href="/contact/">Discuss project support</Action></ServicePage></Site>
