{
  "name": "@effortlessmetrics/still",
  "version": "0.2.2",
  "description": "Readable Astro service-site design, components and page composition.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CHANGELOG.md"
  ],
  "exports": {
    "./layout": {
      "types": "./src/Layout.d.ts",
      "default": "./src/Layout.astro"
    },
    "./header": {
      "types": "./src/Header.d.ts",
      "default": "./src/Header.astro"
    },
    "./footer": {
      "types": "./src/Footer.d.ts",
      "default": "./src/Footer.astro"
    },
    "./page": {
      "types": "./src/Page.d.ts",
      "default": "./src/Page.astro"
    },
    "./opening": {
      "types": "./src/Opening.d.ts",
      "default": "./src/Opening.astro"
    },
    "./section": {
      "types": "./src/Section.d.ts",
      "default": "./src/Section.astro"
    },
    "./offer-grid": {
      "types": "./src/OfferGrid.d.ts",
      "default": "./src/OfferGrid.astro"
    },
    "./offer": {
      "types": "./src/Offer.d.ts",
      "default": "./src/Offer.astro"
    },
    "./action": {
      "types": "./src/Action.d.ts",
      "default": "./src/Action.astro"
    },
    "./service-page": {
      "types": "./src/ServicePage.d.ts",
      "default": "./src/ServicePage.astro"
    },
    "./service-columns": {
      "types": "./src/ServiceColumns.d.ts",
      "default": "./src/ServiceColumns.astro"
    },
    "./service-offer": {
      "types": "./src/ServiceOffer.d.ts",
      "default": "./src/ServiceOffer.astro"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "astro": "^7.3.5"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EffortlessMetrics/still-core.git",
    "directory": "packages/still"
  },
  "homepage": "https://github.com/EffortlessMetrics/still-core#readme",
  "bugs": {
    "url": "https://github.com/EffortlessMetrics/still-core/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
