{
  "name": "still-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/still",
    "starter"
  ],
  "scripts": {
    "build": "npm run build --workspace starter",
    "check": "npm run check --workspace starter && node scripts/audit-boundary.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "pack:still": "npm pack --workspace @effortlessmetrics/still --ignore-scripts",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:contract": "node scripts/verify-minimal-consumer.mjs",
    "verify:upgrade": "node scripts/verify-thin-upgrade.mjs",
    "starter:export": "node scripts/create-starter.mjs",
    "verify:types": "node scripts/verify-component-types.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "parse5": "8.0.1"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
